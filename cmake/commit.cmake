# Writes reagentlive/commit.h with the source tree's git commit, run on every
# build (the reagentlive-commit target). The file changes only when the
# commit does, so nothing rebuilds otherwise. No git or no repository:
# "unknown". Inputs: SOURCE (the reagentlive folder), OUTPUT (the header).
execute_process(COMMAND git -C "${SOURCE}" rev-parse --short=12 HEAD
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
if(failed OR commit STREQUAL "")
    set(commit "unknown")
else()
    execute_process(COMMAND git -C "${SOURCE}" status --porcelain --untracked-files=no
        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT changes STREQUAL "")
        string(APPEND commit "-dirty")
    endif()
endif()
set(text "// Generated by cmake/commit.cmake: the source tree's commit at build time.\n#pragma once\n#define REAGENTLIVE_COMMIT \"${commit}\"\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUTPUT}" "${text}")
endif()
